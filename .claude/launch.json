{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "@instasupply/backend", "run", "dev"],
      "port": 4000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "@instasupply/frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "driver-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "@instasupply/driver", "run", "web", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "customer-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "@instasupply/customer", "run", "web"],
      "port": 8082
    }
  ]
}
