# ---------------------------------------------------------------- dependencies
node_modules/
.npm/
*.tgz

# ---------------------------------------------------------------- builds and caches
dist/
web-build/
coverage/
*.tsbuildinfo
.eslintcache
.cache/
# Android build workspace (disk image mounted at a path without spaces), APKs and logs
.build/
*.sparseimage
*.dmg

# ---------------------------------------------------------------- Expo and native projects (generated by prebuild)
.expo/
.expo-shared/
expo-env.d.ts
app/*/ios/
app/*/android/
*.hprof

# ---------------------------------------------------------------- release artefacts and signing keys: never commit
*.apk
*.aab
*.ipa
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
*.cer
*.pem
*.key
keystore.properties
*-release.properties
credentials.json
service-account*.json
*-firebase-adminsdk-*.json

# Push notification config files (downloaded from Firebase or Apple)
google-services.json
GoogleService-Info.plist

# ---------------------------------------------------------------- environment and secrets
# Only the documented templates are committed; real values live on Railway or in local files.
.env
.env.*
!.env.example
*.secret
*.secrets
.secret.local

# ---------------------------------------------------------------- local data
backend/.data/
.pgdata/
*.sqlite
*.dump
*.sql.gz
legacy/.emulator-data/

# ---------------------------------------------------------------- editors, OS and tools
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.claude/

# ---------------------------------------------------------------- logs
*.log
npm-debug.log*
logs/
