# Cloud Functions runtime configuration.
# Copy to `.env.<project-id>` (deployed) or `.env.local` (emulator only). Never commit real values.
# Values listed in MANAGED_SECRETS are read from Google Secret Manager instead of this file:
#   firebase functions:secrets:set GOOGLE_MAPS_API_KEY

# Region for every function. Must match your Firestore location (e.g. asia-south1 for Mumbai).
FUNCTIONS_REGION=us-central1

# Comma-separated names of secrets stored in Secret Manager (recommended in production).
# MANAGED_SECRETS=GOOGLE_MAPS_API_KEY,TWILIO_AUTH_TOKEN,OTP_PEPPER

# Public URL of the back office, used to build customer tracking links.
TRACKING_BASE_URL=http://localhost:5173

# Routing: auto (Google if a key is set, otherwise estimates) | google | osrm | estimate
ROUTING_PROVIDER=auto
# OSRM_URL=https://router.project-osrm.org
# GOOGLE_MAPS_API_KEY=

# Geocoding: auto (Google if a key is set, otherwise OpenStreetMap Nominatim) | google | nominatim | none
GEOCODER=auto

# SMS via Twilio. Without these, SMS (OTP codes, tracking links) goes to the dev outbox.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15555550100

# Secret used to hash OTP codes. Required in production (use Secret Manager).
# OTP_PEPPER=

# Test phone numbers that always accept a fixed code (format +E164:code, comma separated).
OTP_TEST_NUMBERS=+919999999999:123456,+918888888888:123456,+917777777777:123456

# Reject callable requests without a valid App Check token (enable once App Check is set up).
ENFORCE_APP_CHECK=false

# Optional Expo push access token (only needed if you enabled push security on expo.dev).
# EXPO_ACCESS_TOKEN=

# Keep at least one warm instance of latency-sensitive callables in production (costs money).
MIN_INSTANCES=0
