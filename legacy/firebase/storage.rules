rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function role() {
      return request.auth != null ? request.auth.token.get('role', '') : '';
    }
    function isStaff() {
      return role() in ['admin', 'dispatcher'] && request.auth.token.get('active', false) == true;
    }
    function isAssignedDriver(deliveryId) {
      return role() == 'driver'
        && firestore.get(/databases/(default)/documents/deliveries/$(deliveryId)).data.driverId == request.auth.uid;
    }
    function isImageUnder(megabytes) {
      return request.resource.size < megabytes * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Proof-of-delivery photos: written once by the assigned driver, read by staff and that driver.
    match /proofs/{deliveryId}/{fileName} {
      allow read: if isStaff() || isAssignedDriver(deliveryId);
      allow create: if isAssignedDriver(deliveryId) && isImageUnder(10);
      allow update, delete: if false;
    }

    // Profile photos.
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid && isImageUnder(5);
    }
  }
}
