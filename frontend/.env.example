# Back office configuration. Copy to `.env.local` (dev) or set in CI for builds.
# Values come from Firebase console → Project settings → Your apps → Web app.

# Connect to the local Firebase emulators instead of the cloud project.
VITE_USE_EMULATORS=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Must match FUNCTIONS_REGION in firebase/functions.
VITE_FUNCTIONS_REGION=us-central1

# Optional map tiles. Defaults to OpenStreetMap (fine for development; use a commercial
# provider such as MapTiler, Stadia or Mapbox in production).
# VITE_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
