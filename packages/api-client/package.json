{
  "name": "@instasupply/api-client",
  "version": "1.0.0",
  "private": true,
  "description": "InstaSupply API client: session, typed commands, REST, live socket, query cache and React hooks for the web console and the Expo apps.",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts",
    "./web": "./src/web/index.ts",
    "./native": "./src/native/index.ts",
    "./testing": "./src/testing/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "tsx --test test/*.test.ts test/*.test.tsx"
  },
  "dependencies": {
    "@instasupply/shared": "*"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": "*",
    "expo-crypto": "*",
    "expo-network": "*",
    "expo-secure-store": "*",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "@react-native-async-storage/async-storage": {
      "optional": true
    },
    "expo-secure-store": {
      "optional": true
    },
    "expo-network": {
      "optional": true
    },
    "expo-crypto": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "expo-crypto": "~58.0.8",
    "expo-network": "~58.0.5",
    "expo-secure-store": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
