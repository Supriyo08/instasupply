# Every variable of docs/PLATFORM.md §11.1 with its development default. Development needs no .env file:
# copy this to backend/.env only to override something. Never commit a .env file, and never put a real
# secret here. Production values are set on Railway (docs/DEPLOYMENT.md §2.2); with NODE_ENV=production
# an unset variable takes its production value and unsafe values stop the server (§11.1).

# ---------- server ----------
NODE_ENV=development
PORT=4000
HOST=::
# Public origin of this API (media and upload URLs). Unset outside production: the request's own origin.
API_URL=
# Injected by Railway; production derives API_URL from it when API_URL is unset.
RAILWAY_PUBLIC_DOMAIN=
# Public origin of the console: set-password links and tracking links.
WEB_URL=http://localhost:5173
# Browser origins allowed to call the API, comma-separated. Local and LAN origins are allowed outside production.
CORS_ORIGINS=
# Read the client address from X-Real-IP (true behind Railway's edge).
TRUST_PROXY=false
LOG_LEVEL=debug
LOG_PRETTY=true

# ---------- database ----------
DATABASE_URL=postgres://localhost:5432/instasupply_dev
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_AUTO_CREATE=true
MIGRATE_ON_START=true

# ---------- auth (development-only secrets; production refuses these values) ----------
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_SECRET_PREVIOUS=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=60
SESSION_MAX_DAYS=180
INVITE_LINK_TTL_HOURS=72
OTP_PEPPER=dev-only-pepper-change-me-0123456789abcdef
OTP_TEST_NUMBERS=+14165550199:123456,+16475550199:123456,+19055550199:123456
PHONE_VERIFICATION=required
EXPOSE_DEV_CODES=true

# ---------- marketplace ----------
PAYMENTS_MODE=test
ALLOW_TEST_JOBS=true
SEED_PASSWORD=Instasupply@123
HST_NUMBER="000000000 RT0001"
SUPPORT_PHONE=+14165550100
SUPPORT_EMAIL=support@instasupply.test
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="© OpenStreetMap contributors"
MAP_MAX_ZOOM=19

# ---------- files ----------
STORAGE_DRIVER=local
# Empty: backend/.data/files.
STORAGE_LOCAL_DIR=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
FILE_URL_TTL_SECONDS=300

# ---------- SMS, email, push ----------
SMS_DRIVER=outbox
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
EMAIL_DRIVER=outbox
EMAIL_FROM="InstaSupply <no-reply@instasupply.test>"
RESEND_API_KEY=
SMTP_URL=
PUSH_ENABLED=true
EXPO_ACCESS_TOKEN=

# ---------- routing and geocoding ----------
GOOGLE_MAPS_API_KEY=
ROUTING_PROVIDER=auto
OSRM_URL=https://router.project-osrm.org
GEOCODER=auto
NOMINATIM_URL=https://nominatim.openstreetmap.org
GEO_USER_AGENT=InstaSupply-dev/1.0

# ---------- background work ----------
RUN_WORKER=true
RUN_SCHEDULER=true
OUTBOX_POLL_MS=1000
OUTBOX_BATCH=20
OUTBOX_CONCURRENCY=4
SHUTDOWN_GRACE_MS=20000
RATE_LIMIT_PER_MINUTE=600
RATE_LIMITS_DISABLED=false

# The test runner alone reads the libpq variables PGHOST, PGPORT, PGUSER, PGPASSWORD (unset: the local server).
