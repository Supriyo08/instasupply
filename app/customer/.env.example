# Customer app configuration. EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
# For local development copy to .env.local (or use .env.development, which targets the emulators).

# Talk to the local Firebase Emulator Suite instead of a real project.
EXPO_PUBLIC_USE_EMULATORS=true
# Optional: machine running the emulators. Auto-detected from the Expo dev server when empty.
EXPO_PUBLIC_EMULATOR_HOST=

# Firebase web app config (Firebase console → Project settings → Your apps → Web app).
EXPO_PUBLIC_FIREBASE_API_KEY=demo-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-instasupply.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-instasupply
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-instasupply.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FUNCTIONS_REGION=us-central1

# Customer support line shown in the app.
EXPO_PUBLIC_SUPPORT_PHONE=+919000000000

# Native build settings (read by app.config.ts, not bundled).
# EAS_PROJECT_ID=
# GOOGLE_MAPS_ANDROID_API_KEY=
# GOOGLE_SERVICES_JSON=./google-services.json
