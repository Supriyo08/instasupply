# Customer app configuration (docs/CLIENTS.md §8.2). EXPO_PUBLIC_* values are bundled into the app,
# so never put secrets here. Copy to .env.local to override .env.development on this machine.

# Origin of the API, `https://host[:port]`, no path, no trailing slash. Empty in development: the app
# finds the API on the machine that runs `expo start` (LAN address, 10.0.2.2 on the Android emulator).
EXPO_PUBLIC_API_URL=
# Development only: the port of the local API (`npm run dev:backend`).
EXPO_PUBLIC_API_PORT=4000

# Support phone, HST number, map tiles, payments mode and phone verification come from GET /config.

# Native build settings (read by app.config.ts, not bundled).
# APP_VARIANT=development
# EAS_PROJECT_ID=
# GOOGLE_SERVICES_JSON=./google-services.json
