# Driver app configuration. EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
# Copy to .env.local to override .env.development / .env.production (docs/CLIENTS.md §8.2).

# Origin of the API, https://host[:port], no path, no trailing slash. Empty in development: the app
# uses the dev machine (LAN address from the Expo dev server, 10.0.2.2 on the Android emulator).
EXPO_PUBLIC_API_URL=
# Development only: the port of the local API (npm run dev:backend).
EXPO_PUBLIC_API_PORT=4000

# Native build settings (read by app.config.ts, not bundled).
# APP_VARIANT=development    # development | preview | production (app name and application id suffix)
# EAS_PROJECT_ID=            # Expo project: needed for push (docs/CLIENTS.md §6.1)
# GOOGLE_SERVICES_JSON=./google-services.json   # FCM transport for Expo push on Android
